C4Container
    title Container diagram for Avion Engine
    Person(Developer, "Developer", "A user of avion engine, who it developing games with use it")

    Container_Boundary(c1, "Avion Engine") {
        Container(editor, "Editor", "C++ executable file", "Редактор игрового движка с UI обеспечивающий работу с игровыми сущностями (ассеты, 
        освещение, шейдеры))")
        Container(core, "Core (Engine Runtime)", "C++ Library", "Подсистема рендеринга и освещения, подсистема загрузки ассетов, управление сценой")
        Container(gui, "GUI", "C++ Library", "")
    }

    System_Ext("Game", "2D/3D Game", "A custom game using the capabilities of the game engine")

    Rel(Developer, editor, "Developing game")
